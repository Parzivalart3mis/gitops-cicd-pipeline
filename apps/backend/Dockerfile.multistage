# syntax=docker/dockerfile:1
#
# Dockerfile.multistage — optimised multi-stage build for the backend.
# This is the Dockerfile CI's build-and-push job uses.
#
# Stage 1 (test): installs runtime + dev dependencies, runs pytest with an
#   80 % coverage gate, then stages the application source (minus tests) in
#   /out.
#
# Stage 2 (production): copies its source FROM the test stage. That
#   dependency matters: BuildKit only builds stages the target depends on, so
#   a test stage nothing copies from is silently skipped. Because production
#   needs /out, the tests always run, and a failing test fails the build.

# ---------------------------------------------------------------------------
# Stage 1 — test runner
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS test

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

COPY pyproject.toml ./
COPY src/ ./src/

RUN pytest src/tests/ -q --tb=short --cov=src --cov-fail-under=80 \
    && mkdir -p /out \
    && cp -r src /out/src \
    && rm -rf /out/src/tests

# ---------------------------------------------------------------------------
# Stage 2 — production image
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS production

LABEL org.opencontainers.image.source="https://github.com/Parzivalart3mis/gitops-cicd-pipeline"
LABEL org.opencontainers.image.description="GitOps demo backend (production)"
LABEL org.opencontainers.image.licenses="MIT"

WORKDIR /app

# Fixed UID/GID 1000 so the image user matches the Deployment's
# runAsUser/runAsGroup. Never run application code as root.
RUN groupadd --gid 1000 appgroup \
    && useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin appuser

# Runtime dependencies only; pytest & co. never reach this image.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application source, taken from the stage where the tests just passed.
COPY --from=test /out/src ./src/

# GIT_SHA is baked in as a default; Kubernetes overrides it from the
# app-config ConfigMap so /healthz reports the deployed commit.
ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA} \
    ENVIRONMENT=local \
    LOG_LEVEL=info \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Numeric USER so kubelet can verify runAsNonRoot without a passwd lookup.
USER 1000:1000

EXPOSE 8000

# Kubernetes probes call /healthz; this HEALTHCHECK mirrors that probe locally.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/healthz')" || exit 1

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
