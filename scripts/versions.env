# scripts/versions.env — Pinned versions of everything installed into the
# local Kind cluster. Sourced by setup-cluster.sh, install-argocd.sh and
# install-observability.sh.
#
# Pinning means `make setup` installs the same thing every time: an unpinned
# chart silently jumped Argo CD from v2.x to v3.x and dropped values keys.
# When bumping a chart, re-check its values file against the new defaults:
#   helm show values <repo>/<chart> --version <new>

# Ingress controller (static manifest from the kubernetes/ingress-nginx repo).
# NOTE: ingress-nginx is retired upstream; this is its final release. Moving
# to a Gateway API implementation is listed under Future Improvements.
INGRESS_NGINX_VERSION="controller-v1.15.1"

# Helm charts: <repo URL> / <chart> / <version>
METRICS_SERVER_REPO="https://kubernetes-sigs.github.io/metrics-server/"
METRICS_SERVER_CHART_VERSION="3.14.0"

SEALED_SECRETS_REPO="https://bitnami.github.io/sealed-secrets"
SEALED_SECRETS_CHART_VERSION="2.22.0"

GATEKEEPER_REPO="https://open-policy-agent.github.io/gatekeeper/charts"
GATEKEEPER_CHART_VERSION="3.23.1"

ARGOCD_REPO="https://argoproj.github.io/argo-helm"
ARGOCD_CHART_VERSION="10.15.0"            # Argo CD v3.6.x

PROMETHEUS_COMMUNITY_REPO="https://prometheus-community.github.io/helm-charts"
KUBE_PROMETHEUS_STACK_CHART_VERSION="93.1.0"

GRAFANA_COMMUNITY_REPO="https://grafana-community.github.io/helm-charts"
GRAFANA_CHART_VERSION="14.4.0"            # grafana-community/grafana (Grafana 13.x)
LOKI_CHART_VERSION="21.0.0"               # grafana-community/loki (Loki 3.7.x)

GRAFANA_REPO="https://grafana.github.io/helm-charts"
ALLOY_CHART_VERSION="1.15.0"              # grafana/alloy
