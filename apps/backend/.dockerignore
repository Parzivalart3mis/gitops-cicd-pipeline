# .dockerignore — exclude files from the Docker build context.
# Keeping the context small speeds up builds and avoids accidentally
# shipping test code or dev tooling into production images.

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Test artefacts. The tests themselves (src/tests/) must stay in the build
# context: Dockerfile.multistage runs them in its test stage, and the
# production stage copies only the non-test source out of that stage.
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Virtual environments
.venv/
venv/
env/

# Development tooling
.mypy_cache/
.ruff_cache/
.pre-commit-config.yaml

# Editor / OS artefacts
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore
