# syntax=docker/dockerfile:1
#
# Dockerfile.multistage — optimised multi-stage build for the frontend.
# This is the Dockerfile CI's build-and-push job uses.
#
# Stage 1 (build): Node.js stage for static asset builds. This project uses
#   plain HTML (no bundler), so it just passes files through, but having the
#   stage means Vite/React/Vue can be swapped in without touching the pipeline.
#
# Stage 2 (production): copies only the built static files into a minimal,
#   non-root Nginx Alpine image.

# ---------------------------------------------------------------------------
# Stage 1 — build (currently a pass-through for plain HTML)
# ---------------------------------------------------------------------------
FROM node:24-alpine AS build

WORKDIR /build

COPY src/ ./src/

# For a React/Vite project this would be:
#   RUN npm ci && npm run build
RUN cp -r src/ dist/

# ---------------------------------------------------------------------------
# Stage 2 — production Nginx image
# ---------------------------------------------------------------------------
FROM nginx:1.30-alpine AS production

LABEL org.opencontainers.image.source="https://github.com/Parzivalart3mis/gitops-cicd-pipeline"
LABEL org.opencontainers.image.description="GitOps demo frontend (production)"
LABEL org.opencontainers.image.licenses="MIT"

# Upgrade Alpine packages to pull the latest security patches at build time.
RUN apk upgrade --no-cache \
    && rm /etc/nginx/conf.d/default.conf \
    && mkdir -p /etc/nginx/snippets

COPY nginx.conf               /etc/nginx/nginx.conf
COPY --from=build /build/dist/ /usr/share/nginx/html/
COPY entrypoint.sh            /entrypoint.sh

# The nginx user (UID 101) must be able to write: the HTML (placeholder
# substitution), the snippets dir (backend proxy), cache, logs and pid file.
RUN chmod +x /entrypoint.sh \
    && chown -R nginx:nginx /usr/share/nginx/html /etc/nginx/snippets /var/cache/nginx /var/log/nginx \
    && touch /tmp/nginx.pid \
    && chown nginx:nginx /tmp/nginx.pid

# Shown in the UI when the container runs outside Kubernetes; in-cluster the
# frontend-config ConfigMap sets the value.
ARG FRONTEND_VERSION=unknown
ENV FRONTEND_VERSION=${FRONTEND_VERSION}

USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/healthz || exit 1

ENTRYPOINT ["/entrypoint.sh"]
